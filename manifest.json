{
  "manifest_version": 3,
  "name": "YouTube Player Tweaks",
  "version": "1.0.7",
  "description": "Personal YouTube player styles + a Comments button for cinema (theater) mode.",
  "browser_specific_settings": {
    "gecko": {
      "id": "youtube-player-tweaks@desktop.local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "css": ["player.css", "cinema-comments.css"],
      "js": ["cinema-comments.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
